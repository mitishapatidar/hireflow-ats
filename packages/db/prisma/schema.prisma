generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  RECRUITER
  MANAGER
  ADMIN
  CLIENT
  CANDIDATE
}

enum ClientStatus {
  ACTIVE
  PROSPECT
  INACTIVE
}

enum JobStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  CLOSED
}

enum ApplicationStatus {
  SOURCED
  SCREENING
  INTERVIEW
  TECHNICAL
  CLIENT_REVIEW
  OFFER
  PLACED
  REJECTED
}

enum InterviewOutcome {
  SCHEDULED
  COMPLETED
  NO_SHOW
  RESCHEDULED
  CANCELLED
}

enum SubmissionApprovalStatus {
  PENDING_MANAGER_APPROVAL
  APPROVED
  REJECTED
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum PaymentStatus {
  PENDING
  INVOICED
  PAID
  OVERDUE
}

enum OpportunityStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum MessageChannel {
  EMAIL
  WHATSAPP
  SMS
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ==========================================
// MODULE A: ORGANIZATION & ACCESS MANAGEMENT
// ==========================================

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  domain      String?
  settings    Json?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  users                  User[]
  teams                  Team[]
  invitations            Invitation[]
  clients                Client[]
  jobs                   Job[]
  candidates             Candidate[]
  customFieldDefinitions CustomFieldDefinition[]

  @@index([status])
}

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  name              String
  passwordHash      String?
  role              UserRole     @default(RECRUITER)
  status            String       @default("ACTIVE")
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  managerId         String?
  manager           User?        @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates      User[]       @relation("UserManager")
  teamId            String?
  team              Team?        @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  twoFactorEnabled  Boolean      @default(false)
  twoFactorSecret   String?
  lastLoginAt       DateTime?
  isArchived        Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  createdById       String?

  sessions               Session[]
  invitationsSent        Invitation[]              @relation("InvitedByUser")
  clientAccesses         ClientAccess[]
  candidatesOwned        Candidate[]               @relation("CandidateOwner")
  jobsOwned              Job[]                     @relation("JobOwner")
  managedTeams           Team[]                    @relation("TeamManager")
  jobAssignmentsReceived JobAssignment[]          @relation("JobRecruiterAssignment")
  jobAssignmentsGiven    JobAssignment[]          @relation("JobAssigner")
  interviewPanels        InterviewPanelMember[]
  interviewFeedbacks     InterviewFeedback[]
  tasksAssigned          Task[]                    @relation("TaskAssignee")
  notifications          Notification[]
  notificationPrefs      NotificationPreference[]
  teamSignatures         TeamSignature[]
  dailyActivities        DailyActivity[]
  clientsOwned           Client[]                  @relation("ClientOwner")
  opportunitiesOwned     Opportunity[]             @relation("OpportunityOwner")

  @@index([organizationId])
  @@index([role])
  @@index([managerId])
  @@index([teamId])
  @@index([isArchived])
}

model Team {
  id             String       @id @default(uuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  managerId      String?
  manager        User?        @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdById    String?

  members User[] @relation("TeamMembers")

  @@index([organizationId])
}

model Session {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  deviceInfo  String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model Invitation {
  id             String       @id @default(uuid())
  email          String
  role           UserRole
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById    String
  invitedBy      User         @relation("InvitedByUser", fields: [invitedById], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  status         String       @default("PENDING")
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdById    String?

  @@index([email])
  @@index([organizationId])
  @@index([status])
}

model ClientAccess {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorizedJobIds String[] @default([])
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdById      String?

  @@unique([userId, clientId])
  @@index([userId])
  @@index([clientId])
}

// ==========================================
// MODULE B: CANDIDATE MANAGEMENT
// ==========================================

model Candidate {
  id                String       @id @default(uuid())
  code              String       @unique
  name              String
  email             String
  phone             String?
  currentTitle      String?
  currentCompany    String?
  experienceYears   Decimal?     @db.Decimal(4, 1)
  currentSalary     Decimal?     @db.Decimal(12, 2)
  expectedSalary    Decimal?     @db.Decimal(12, 2)
  noticePeriod      String?
  location          String?
  skills            String[]     @default([])
  source            String?
  ownerId           String?
  owner             User?        @relation("CandidateOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  consentRecordedAt DateTime?
  isArchived        Boolean      @default(false)
  archivedAt        DateTime?
  archivedById      String?
  archiveReason     String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  createdById       String?

  notes        CandidateNote[]
  tags         CandidateTag[]
  documents    CandidateDocument[]
  applications Application[]

  @@index([organizationId])
  @@index([ownerId])
  @@index([email])
  @@index([isArchived])
  @@index([createdAt])
  @@index([ownerId, updatedAt])
}

model CandidateNote {
  id             String    @id @default(uuid())
  candidateId    String
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  authorId       String
  content        String
  isInternalOnly Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?

  @@index([candidateId])
  @@index([authorId])
}

model CandidateTag {
  id          String    @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?

  @@unique([candidateId, name])
  @@index([candidateId])
  @@index([name])
}

model CandidateDocument {
  id            String    @id @default(uuid())
  candidateId   String
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fileName      String
  fileUrl       String
  storageBucket String    @default("resumes")
  documentType  String
  version       Int       @default(1)
  uploadedById  String
  uploadedAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?

  @@index([candidateId])
  @@index([documentType])
}

model CustomFieldDefinition {
  id             String       @id @default(uuid())
  entityType     String
  fieldName      String
  fieldType      String
  options        String[]     @default([])
  isRequired     Boolean      @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdById    String?

  values CustomFieldValue[]

  @@unique([organizationId, entityType, fieldName])
  @@index([organizationId])
}

model CustomFieldValue {
  id                String                @id @default(uuid())
  fieldDefinitionId String
  fieldDefinition   CustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  entityId          String
  value             Json
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  createdById       String?

  @@unique([fieldDefinitionId, entityId])
  @@index([entityId])
}

// ==========================================
// MODULE C: CLIENT CRM
// ==========================================

model Client {
  id                  String        @id @default(uuid())
  code                String        @unique
  legalName           String
  industry            String?
  website             String?
  location            String?
  relationshipOwnerId String?
  relationshipOwner   User?         @relation("ClientOwner", fields: [relationshipOwnerId], references: [id], onDelete: SetNull)
  organizationId      String
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status              ClientStatus  @default(PROSPECT)
  commercialTerms     String?
  feePercentage       Decimal?      @db.Decimal(5, 2)
  isArchived          Boolean       @default(false)
  archivedAt          DateTime?
  archiveReason       String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  createdById         String?

  contacts       ClientContact[]
  documents      ClientDocument[]
  workflows      ClientWorkflow[]
  jobs           Job[]
  clientAccesses ClientAccess[]
  opportunities  Opportunity[]
  meetings       Meeting[]
  offers         Offer[]
  placements     Placement[]

  @@index([organizationId])
  @@index([relationshipOwnerId])
  @@index([status])
  @@index([isArchived])
}

model ClientContact {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  designation String?
  email       String
  phone       String?
  contactType String   @default("PRIMARY")
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  jobsHiring Job[]

  @@index([clientId])
  @@index([email])
}

model ClientDocument {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fileName      String
  fileUrl       String
  storageBucket String   @default("client-documents")
  documentType  String
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?

  @@index([clientId])
}

model ClientWorkflow {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  version       Int      @default(1)
  isActive      Boolean  @default(true)
  configuration Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?

  stages          ClientStage[]
  submissionRules SubmissionRule[]

  @@index([clientId])
}

model ClientStage {
  id            String         @id @default(uuid())
  workflowId    String
  workflow      ClientWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name          String
  order         Int
  configuration Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdById   String?

  @@index([workflowId])
  @@index([order])
}

model SubmissionRule {
  id                      String         @id @default(uuid())
  workflowId              String
  workflow                ClientWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  requiredFields          String[]       @default([])
  profileFormat           String         @default("STANDARDIZED_ANONYMIZED")
  requiresManagerApproval Boolean        @default(true)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  createdById             String?

  @@index([workflowId])
}

// ==========================================
// MODULE D: JOB MANAGEMENT
// ==========================================

model Job {
  id                     String         @id @default(uuid())
  code                   String         @unique
  clientId               String
  client                 Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title                  String
  description            String?
  ownerId                String?
  owner                  User?          @relation("JobOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  hiringManagerContactId String?
  hiringManagerContact   ClientContact? @relation(fields: [hiringManagerContactId], references: [id], onDelete: SetNull)
  organizationId         String
  organization           Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  openings               Int            @default(1)
  location               String?
  salaryMin              Decimal?       @db.Decimal(12, 2)
  salaryMax              Decimal?       @db.Decimal(12, 2)
  status                 JobStatus      @default(DRAFT)
  closingReason          String?
  approvedById           String?
  approvedAt             DateTime?
  isArchived             Boolean        @default(false)
  archivedAt             DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  createdById            String?

  rounds           JobRound[]
  assignments      JobAssignment[]
  statusHistories  JobStatusHistory[]
  applications     Application[]

  @@index([organizationId])
  @@index([clientId])
  @@index([ownerId])
  @@index([status])
  @@index([isArchived])
}

model JobRound {
  id          String      @id @default(uuid())
  jobId       String
  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name        String
  roundOrder  Int
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdById String?

  interviews Interview[]

  @@index([jobId])
  @@index([roundOrder])
}

model JobAssignment {
  id          String   @id @default(uuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  recruiterId String
  recruiter   User     @relation("JobRecruiterAssignment", fields: [recruiterId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy  User     @relation("JobAssigner", fields: [assignedById], references: [id], onDelete: Cascade)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@unique([jobId, recruiterId])
  @@index([jobId])
  @@index([recruiterId])
}

model JobStatusHistory {
  id             String     @id @default(uuid())
  jobId          String
  job            Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  previousStatus JobStatus?
  newStatus      JobStatus
  changedById    String
  reason         String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  createdById    String?

  @@index([jobId])
}

// ==========================================
// MODULE E: RECRUITMENT PIPELINE
// ==========================================

model Application {
  id                String            @id @default(uuid())
  candidateId       String
  candidate         Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId             String
  job               Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stageId           String?
  status            ApplicationStatus @default(SOURCED)
  rejectionReasonId String?
  rejectionReason   RejectionReason?  @relation(fields: [rejectionReasonId], references: [id], onDelete: SetNull)
  appliedAt         DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdById       String?

  stageHistories  ApplicationStageHistory[]
  interviews      Interview[]
  submissions     Submission[]
  offers          Offer[]
  placement       Placement?

  @@unique([candidateId, jobId])
  @@index([candidateId])
  @@index([jobId])
  @@index([stageId])
  @@index([status])
  @@index([jobId, stageId])
}

model ApplicationStageHistory {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStage     String?
  toStage       String
  changedById   String
  comments      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  createdById   String?

  @@index([applicationId])
}

model RejectionReason {
  id          String   @id @default(uuid())
  code        String   @unique
  reason      String
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  applications Application[]

  @@index([category])
}

// ==========================================
// MODULE F: INTERVIEW MANAGEMENT
// ==========================================

model Interview {
  id            String           @id @default(uuid())
  applicationId String
  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  roundId       String?
  round         JobRound?        @relation(fields: [roundId], references: [id], onDelete: SetNull)
  scheduledAt   DateTime
  duration      Int              @default(45)
  mode          String           @default("VIDEO")
  provider      String           @default("GOOGLE_MEET")
  meetingLink   String?
  outcome       InterviewOutcome @default(SCHEDULED)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  createdById   String?

  panelMembers    InterviewPanelMember[]
  feedbacks       InterviewFeedback[]
  slotInvitations SlotInvitation[]

  @@index([applicationId])
  @@index([scheduledAt])
  @@index([outcome])
}

model InterviewPanelMember {
  id          String    @id @default(uuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("INTERVIEWER")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?

  @@unique([interviewId, userId])
  @@index([interviewId])
  @@index([userId])
}

model InterviewFeedback {
  id             String    @id @default(uuid())
  interviewId    String
  interview      Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  reviewerId     String
  reviewer       User      @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  rating         Int
  feedback       String
  recommendation String
  submittedAt    DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?

  @@unique([interviewId, reviewerId])
  @@index([interviewId])
  @@index([reviewerId])
}

model SlotInvitation {
  id            String     @id @default(uuid())
  interviewId   String?
  interview     Interview? @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  applicationId String
  invitedUserId String?
  token         String     @unique
  status        String     @default("PENDING")
  expiresAt     DateTime
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  createdById   String?

  slotOptions SlotOption[]

  @@index([applicationId])
  @@index([token])
}

model SlotOption {
  id           String         @id @default(uuid())
  invitationId String
  invitation   SlotInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  startTime    DateTime
  endTime      DateTime
  isSelected   Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  createdById  String?

  @@index([invitationId])
}

// ==========================================
// MODULE G: SUBMISSIONS, OFFERS & PLACEMENTS
// ==========================================

model Submission {
  id                     String                   @id @default(uuid())
  code                   String                   @unique
  applicationId          String
  application            Application              @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  version                Int                      @default(1)
  standardProfileVersion String                   @default("1.0")
  approvalStatus         SubmissionApprovalStatus @default(PENDING_MANAGER_APPROVAL)
  approvedById           String?
  sentAt                 DateTime?
  clientDecision         String?
  clientFeedback         String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  createdById            String?

  approvals SubmissionApproval[]

  @@index([applicationId])
  @@index([approvalStatus])
}

model SubmissionApproval {
  id           String     @id @default(uuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerId   String
  decision     String
  comments     String?
  approvedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdById  String?

  @@index([submissionId])
  @@index([reviewerId])
}

model Offer {
  id                String      @id @default(uuid())
  applicationId     String
  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  clientId          String
  client            Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  offeredSalary     Decimal     @db.Decimal(12, 2)
  joiningDate       DateTime?
  status            OfferStatus @default(DRAFT)
  offerDocumentUrl  String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  createdById       String?

  @@index([applicationId])
  @@index([clientId])
  @@index([status])
}

model Placement {
  id            String        @id @default(uuid())
  applicationId String        @unique
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  feeBasis      String        @default("PERCENTAGE")
  feeAmount     Decimal       @db.Decimal(12, 2)
  paymentTerms  String        @default("NET_30")
  dueDate       DateTime?
  paymentStatus PaymentStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdById   String?

  @@index([applicationId])
  @@index([clientId])
  @@index([paymentStatus])
}

// ==========================================
// MODULE H: SALES & CLIENT RELATIONSHIP
// ==========================================

model Opportunity {
  id                String           @id @default(uuid())
  clientId          String
  client            Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ownerId           String
  owner             User             @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  stage             OpportunityStage @default(PROSPECTING)
  estimatedValue    Decimal?         @db.Decimal(12, 2)
  expectedCloseDate DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  createdById       String?

  @@index([clientId])
  @@index([ownerId])
  @@index([stage])
}

model Meeting {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organizerId String
  title       String
  scheduledAt DateTime
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@index([clientId])
  @@index([organizerId])
}

// ==========================================
// MODULE I: COMMUNICATIONS & AUTOMATION
// ==========================================

model Template {
  id          String         @id @default(uuid())
  title       String
  channel     MessageChannel
  subject     String?
  body        String
  variables   String[]       @default([])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdById String?

  @@index([channel])
}

model TeamSignature {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  signatureHtml String
  isDefault     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?

  @@index([userId])
}

model Thread {
  id          String         @id @default(uuid())
  channel     MessageChannel
  subject     String?
  candidateId String?
  clientId    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdById String?

  messages Message[]

  @@index([candidateId])
  @@index([clientId])
}

model Message {
  id          String           @id @default(uuid())
  threadId    String
  thread      Thread           @relation(fields: [threadId], references: [id], onDelete: Cascade)
  channel     MessageChannel
  direction   MessageDirection
  status      String           @default("SENT")
  sender      String
  recipient   String
  body        String
  sentAt      DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdById String?

  @@index([threadId])
  @@index([channel])
  @@index([sentAt])
}

model IntegrationAccount {
  id              String   @id @default(uuid())
  provider        String
  encryptedTokens String
  scopes          String[] @default([])
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String?

  @@index([provider])
}

model AutomationRule {
  id            String   @id @default(uuid())
  name          String
  triggerEvent  String
  conditions    Json
  actions       Json
  version       Int      @default(1)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?

  @@index([triggerEvent])
  @@index([isActive])
}

model Task {
  id           String       @id @default(uuid())
  title        String
  description  String?
  assignedToId String
  assignedTo   User         @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)
  dueDate      DateTime?
  status       TaskStatus   @default(PENDING)
  priority     TaskPriority @default(MEDIUM)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdById  String?

  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
}

model Notification {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?

  @@index([userId])
  @@index([readAt])
}

model NotificationPreference {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel     String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@unique([userId, channel])
  @@index([userId])
}

// ==========================================
// MODULE J: REPORTING, IMPORTS & AUDIT
// ==========================================

model ReportDefinition {
  id          String   @id @default(uuid())
  name        String
  queryConfig Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  scheduledReports ScheduledReport[]
}

model ScheduledReport {
  id                 String           @id @default(uuid())
  reportDefinitionId String
  reportDefinition   ReportDefinition @relation(fields: [reportDefinitionId], references: [id], onDelete: Cascade)
  cronExpression     String
  recipients         String[]         @default([])
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  createdById        String?

  deliveries ReportDelivery[]

  @@index([reportDefinitionId])
}

model ReportDelivery {
  id                String          @id @default(uuid())
  scheduledReportId String
  scheduledReport   ScheduledReport @relation(fields: [scheduledReportId], references: [id], onDelete: Cascade)
  deliveredAt       DateTime        @default(now())
  status            String          @default("DELIVERED")
  fileUrl           String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdById       String?

  @@index([scheduledReportId])
}

model ImportBatch {
  id               String   @id @default(uuid())
  fileName         String
  importType       String
  uploadedById     String
  totalRecords     Int      @default(0)
  processedRecords Int      @default(0)
  failedRecords    Int      @default(0)
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdById      String?

  items ImportItem[]

  @@index([uploadedById])
  @@index([status])
}

model ImportItem {
  id            String      @id @default(uuid())
  importBatchId String
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  recordData    Json
  status        String      @default("PENDING")
  errorMessage  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  createdById   String?

  @@index([importBatchId])
  @@index([status])
}

model DuplicatePair {
  id                   String   @id @default(uuid())
  primaryCandidateId   String
  duplicateCandidateId String
  matchScore           Decimal  @db.Decimal(5, 2)
  matchReasons         String[] @default([])
  status               String   @default("UNREVIEWED")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  createdById          String?

  @@index([primaryCandidateId])
  @@index([duplicateCandidateId])
  @@index([status])
}

model DownloadLog {
  id           String   @id @default(uuid())
  userId       String
  resourceType String
  resourceId   String
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String?

  @@index([userId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

model DailyActivity {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                DateTime @db.Date
  candidatesSourced   Int      @default(0)
  interviewsScheduled Int      @default(0)
  submissionsSent     Int      @default(0)
  offersReleased      Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdById         String?

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}
