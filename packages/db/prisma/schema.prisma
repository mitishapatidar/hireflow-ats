generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  RECRUITER
  MANAGER
  ADMIN
  CLIENT
  CANDIDATE
}

enum ClientStatus {
  ACTIVE
  PROSPECT
  INACTIVE
}

enum JobStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  CLOSED
}

enum ApplicationStatus {
  SOURCED
  SCREENING
  INTERVIEW
  TECHNICAL
  CLIENT_REVIEW
  OFFER
  PLACED
  REJECTED
}

enum InterviewOutcome {
  SCHEDULED
  COMPLETED
  NO_SHOW
  RESCHEDULED
  CANCELLED
}

enum SubmissionApprovalStatus {
  APPROVAL_NOT_REQUIRED
  PENDING_MANAGER_APPROVAL
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  APPROVAL_INVALIDATED
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum PaymentStatus {
  PENDING
  INVOICED
  PAID
  OVERDUE
}

enum OpportunityStage {
  PROSPECTING
  MEETING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum MessageChannel {
  EMAIL
  WHATSAPP
  SMS
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ==========================================
// MODULE A: ORGANIZATION & ACCESS MANAGEMENT
// ==========================================

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  domain      String?
  settings    Json?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  users                  User[]
  teams                  Team[]
  invitations            Invitation[]
  clients                Client[]
  jobs                   Job[]
  candidates             Candidate[]
  stages                 Stage[]
  customFieldDefinitions CustomFieldDefinition[]
  opportunities          Opportunity[]
  recruiterTargets       RecruiterTarget[]
  securityPolicy         SecurityPolicy?
  otpChallenges          OtpChallenge[]
  downloadPolicies       DownloadPolicy[]
  exportRequests         ExportRequest[]
  importBatches          ImportBatch[]
  sourcingItems          SourcingItem[]
  sourcingIntegrations   SourcingIntegration[]

  @@index([status])
}

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  name              String
  passwordHash      String?
  role              UserRole     @default(RECRUITER)
  status            String       @default("ACTIVE")
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  managerId         String?
  manager           User?        @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates      User[]       @relation("UserManager")
  teamId            String?
  team              Team?        @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  twoFactorEnabled  Boolean      @default(false)
  twoFactorSecret   String?
  oauthProvider     String?
  oauthId           String?
  lastLoginAt       DateTime?
  isArchived        Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  createdById       String?

  sessions               Session[]
  invitationsSent        Invitation[]              @relation("InvitedByUser")
  clientAccesses         ClientAccess[]
  candidatesOwned        Candidate[]               @relation("CandidateOwner")
  jobsOwned              Job[]                     @relation("JobOwner")
  managedTeams           Team[]                    @relation("TeamManager")
  jobAssignmentsReceived JobAssignment[]          @relation("JobRecruiterAssignment")
  jobAssignmentsGiven    JobAssignment[]          @relation("JobAssigner")
  reassignmentRequestsMade     JobReassignmentRequest[] @relation("ReassignmentRequestor")
  reassignmentRequestsTargeted JobReassignmentRequest[] @relation("ReassignmentTarget")
  reassignmentRequestsReviewed JobReassignmentRequest[] @relation("ReassignmentReviewer")
  interviewPanels        InterviewPanelMember[]
  interviewFeedbacks     InterviewFeedback[]
  authoredProfileVersions SubmissionProfileVersion[] @relation("ProfileVersionAuthor")
  tasksAssigned          Task[]                    @relation("TaskAssignee")
  notifications          Notification[]
  notificationPrefs      NotificationPreference[]
  teamSignatures         TeamSignature[]
  integrationAccounts    IntegrationAccount[]      @relation("UserIntegrationAccounts")
  threadsAssigned        Thread[]                  @relation("ThreadAssignedRecruiter")
  dailyActivities        DailyActivity[]
  clientsOwned           Client[]                  @relation("ClientOwner")
  opportunitiesOwned     Opportunity[]             @relation("OpportunityOwner")
  opportunitiesConverted Opportunity[]             @relation("OpportunityConvertedBy")
  meetingsOrganized      Meeting[]                 @relation("MeetingOrganizer")
  recruiterActivities    RecruiterActivity[]       @relation("RecruiterLoggedActivities")
  recruiterTargets       RecruiterTarget[]         @relation("RecruiterTargets")
  otpChallenges          OtpChallenge[]
  exportRequests         ExportRequest[]
  extensionTokens        ExtensionCaptureToken[]

  @@index([organizationId])
  @@index([role])
  @@index([managerId])
  @@index([teamId])
  @@index([oauthProvider, oauthId])
  @@index([isArchived])
}

model Team {
  id             String       @id @default(uuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  managerId      String?
  manager        User?        @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdById    String?

  members User[] @relation("TeamMembers")

  @@index([organizationId])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash        String    @unique
  deviceInfo       String?
  ipAddress        String?
  expiresAt        DateTime
  lastActivityAt   DateTime  @default(now())
  lastReverifiedAt DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String?

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([lastActivityAt])
}

model SecurityPolicy {
  id                                   String       @id @default(uuid())
  organizationId                       String       @unique
  organization                         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  allowedAuthMethods                   String[]     @default(["EMAIL_PASSWORD", "GOOGLE"])
  allowedEmailDomains                  String[]     @default([])
  requireTwoStepVerification           Boolean      @default(true)
  otpDeliveryMethod                    String       @default("EMAIL")
  otpExpirySeconds                     Int          @default(300)
  otpResendCooldownSeconds             Int          @default(30)
  otpMaxAttempts                       Int          @default(3)
  maxConcurrentSessions                Int          @default(2)
  inactivityTimeoutMinutes             Int          @default(30)
  warningBeforeExpiryMinutes           Int          @default(5)
  sensitiveActionReverificationMinutes Int          @default(15)
  requireJobApproval                   Boolean      @default(false)
  clientAccessPolicy                   Json?
  updatedById                          String?
  createdAt                            DateTime     @default(now())
  updatedAt                            DateTime     @updatedAt

  @@index([organizationId])
}

model OtpChallenge {
  id                String       @id @default(uuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  challengeHash     String       @unique
  otpHashed         String
  expiresAt         DateTime
  attempts          Int          @default(0)
  resendAvailableAt DateTime
  consumedAt        DateTime?
  revokedAt         DateTime?
  actionContext     String       @default("LOGIN")
  createdAt         DateTime     @default(now())

  @@index([userId])
  @@index([challengeHash])
  @@index([expiresAt])
}

model Invitation {
  id             String       @id @default(uuid())
  email          String
  role           UserRole
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById    String
  invitedBy      User         @relation("InvitedByUser", fields: [invitedById], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  status         String       @default("PENDING")
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdById    String?

  @@index([email])
  @@index([organizationId])
  @@index([status])
}

model ClientAccess {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorizedJobIds String[] @default([])
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdById      String?

  @@unique([userId, clientId])
  @@index([userId])
  @@index([clientId])
}

model PasswordResetToken {
  id          String    @id @default(uuid())
  email       String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  createdById String?

  @@index([email])
  @@index([tokenHash])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ipAddress String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, ipAddress])
  @@index([createdAt])
}

// ==========================================
// MODULE B: CANDIDATE MANAGEMENT
// ==========================================

model Candidate {
  id                String       @id @default(uuid())
  code              String       @unique
  name              String
  email             String
  phone             String?
  currentTitle      String?
  currentCompany    String?
  experienceYears   Decimal?     @db.Decimal(4, 1)
  currentSalary     Decimal?     @db.Decimal(12, 2)
  expectedSalary    Decimal?     @db.Decimal(12, 2)
  noticePeriod      String?
  location          String?
  skills            String[]     @default([])
  source            String?
  ownerId           String?
  owner             User?        @relation("CandidateOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  consentRecordedAt DateTime?
  whatsappOptIn     Boolean      @default(true)
  whatsappOptInAt   DateTime?
  smsOptIn          Boolean      @default(false)
  smsOptInAt        DateTime?
  isArchived        Boolean      @default(false)
  archivedAt        DateTime?
  archivedById      String?
  archiveReason     String?
  mergedIntoCandidateId String?
  mergedInto            Candidate?          @relation("CandidateMerges", fields: [mergedIntoCandidateId], references: [id], onDelete: SetNull)
  mergedCandidates      Candidate[]         @relation("CandidateMerges")
  isMerged              Boolean             @default(false)
  mergedAt              DateTime?
  mergedById            String?
  mergeReason           String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  createdById       String?

  notes        CandidateNote[]
  tags         CandidateTag[]
  documents    CandidateDocument[]
  applications Application[]
  threads      Thread[]
  activities   CandidateActivity[]
  recruiterActivities RecruiterActivity[]

  @@index([organizationId])
  @@index([ownerId])
  @@index([email])
  @@index([isArchived])
  @@index([mergedIntoCandidateId])
  @@index([createdAt])
  @@index([ownerId, updatedAt])
}

model CandidateNote {
  id             String    @id @default(uuid())
  candidateId    String
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  authorId       String
  content        String
  isInternalOnly Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?

  @@index([candidateId])
  @@index([authorId])
}

model CandidateTag {
  id          String    @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?

  @@unique([candidateId, name])
  @@index([candidateId])
  @@index([name])
}

model CandidateDocument {
  id            String    @id @default(uuid())
  candidateId   String
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fileName      String
  fileUrl       String
  storageBucket String    @default("resumes")
  documentType  String
  version       Int       @default(1)
  uploadedById  String
  uploadedAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?

  @@index([candidateId])
  @@index([documentType])
}

model CustomFieldDefinition {
  id              String       @id @default(uuid())
  entityType      String       // CANDIDATE, JOB, CLIENT
  fieldName       String
  fieldKey        String?      // snake_case unique key (e.g. candidate_linkedin, expected_currency)
  fieldType       String       // TEXT, NUMBER, DATE, URL, SELECT, MULTI_SELECT
  description     String?
  options         String[]     @default([])
  isRequired      Boolean      @default(false)
  visibility      String       @default("INTERNAL_ONLY") // INTERNAL_ONLY, CLIENT_PROFILE_INCLUDED
  validationRules Json?        // { minLength, maxLength, minValue, maxValue, pattern, maxItems }
  defaultValue    Json?
  displayOrder    Int          @default(0)
  isActive        Boolean      @default(true)
  version         Int          @default(1)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  createdById     String?
  updatedById     String?

  values      CustomFieldValue[]
  clientRules ClientCustomFieldRule[]

  @@unique([organizationId, entityType, fieldName])
  @@index([organizationId])
  @@index([entityType, isActive])
}

model CustomFieldValue {
  id                String                @id @default(uuid())
  fieldDefinitionId String
  fieldDefinition   CustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  entityId          String
  value             Json
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  createdById       String?

  @@unique([fieldDefinitionId, entityId])
  @@index([entityId])
}

model ClientCustomFieldRule {
  id                String                @id @default(uuid())
  clientId          String
  client            Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fieldDefinitionId String
  fieldDefinition   CustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  isRequired        Boolean               @default(true)
  workflowVersion   Int                   @default(1)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([clientId, fieldDefinitionId])
  @@index([clientId])
}

// ==========================================
// MODULE C: CLIENT CRM
// ==========================================

model Client {
  id                  String        @id @default(uuid())
  code                String        @unique
  legalName           String
  industry            String?
  website             String?
  location            String?
  relationshipOwnerId String?
  relationshipOwner   User?         @relation("ClientOwner", fields: [relationshipOwnerId], references: [id], onDelete: SetNull)
  organizationId      String
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status              ClientStatus  @default(PROSPECT)
  commercialTerms     String?
  feePercentage       Decimal?      @db.Decimal(5, 2)
  paymentTerms        String?       @default("NET_30")
  relationshipNotes   String?
  nextStep            String?
  isArchived          Boolean       @default(false)
  archivedAt          DateTime?
  archiveReason       String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  createdById         String?

  contacts       ClientContact[]
  documents      ClientDocument[]
  workflows      ClientWorkflow[]
  jobs           Job[]
  clientAccesses ClientAccess[]
  opportunities  Opportunity[]
  meetings       Meeting[]
  offers         Offer[]
  placements     Placement[]
  recruiterActivities RecruiterActivity[]
  customFieldRules    ClientCustomFieldRule[]

  @@index([organizationId])
  @@index([relationshipOwnerId])
  @@index([status])
  @@index([isArchived])
}

model ClientContact {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  designation String?
  email       String
  phone       String?
  contactType String   @default("PRIMARY")
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  jobsHiring    Job[]
  opportunities Opportunity[]

  @@index([clientId])
  @@index([email])
}

model ClientDocument {
  id            String    @id @default(uuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fileName      String
  fileUrl       String
  storageKey    String?
  storageBucket String    @default("client-documents")
  documentType  String
  version       Int       @default(1)
  fileSize      Int?      @default(0)
  mimeType      String?   @default("application/pdf")
  checksum      String?
  isVerified    Boolean   @default(false)
  verifiedById  String?
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?

  @@index([clientId])
  @@index([isVerified])
}

model ClientWorkflow {
  id            String    @id @default(uuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  version       Int       @default(1)
  status        String    @default("PUBLISHED") // "DRAFT" | "PUBLISHED" | "ARCHIVED"
  isActive      Boolean   @default(true)
  changeSummary String?
  publishedAt   DateTime?
  publishedById String?
  configuration Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?

  stages          ClientStage[]
  rounds          ClientInterviewRound[]
  submissionRules SubmissionRule[]

  @@index([clientId])
}

model ClientInterviewRound {
  id              String         @id @default(uuid())
  workflowId      String
  workflow        ClientWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name            String
  order           Int
  type            String         @default("TECHNICAL") // "SCREENING" | "TECHNICAL" | "HIRING_MANAGER" | "CULTURE_FIT" | "FINAL"
  isTechnical     Boolean        @default(false)
  isHiringManager Boolean        @default(false)
  isRequired      Boolean        @default(true)
  defaultDuration Int            @default(45) // minutes
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([workflowId])
  @@index([order])
}

model ClientStage {
  id            String         @id @default(uuid())
  workflowId    String
  workflow      ClientWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name          String
  order         Int
  stageType     String         @default("CUSTOM")
  isActive      Boolean        @default(true)
  isArchived    Boolean        @default(false)
  configuration Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdById   String?

  @@index([workflowId])
  @@index([order])
}

model SubmissionRule {
  id                      String         @id @default(uuid())
  workflowId              String
  workflow                ClientWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  requiredFields          String[]       @default([])
  profileFormat           String         @default("STANDARDIZED_ANONYMIZED")
  requiresManagerApproval Boolean        @default(true)
  requirePortfolioUrl     Boolean        @default(false)
  requireExpectedSalary   Boolean        @default(false)
  requireNoticePeriod     Boolean        @default(false)
  requireCandidateConsent Boolean        @default(true)
  requireCvDocument       Boolean        @default(true)
  requireCompleteProfile  Boolean        @default(true)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  createdById             String?

  @@index([workflowId])
}

// ==========================================
// MODULE D: JOB MANAGEMENT
// ==========================================

model Job {
  id                     String         @id @default(uuid())
  code                   String         @unique
  clientId               String
  client                 Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title                  String
  description            String?
  requirements           String?
  employmentType         String?        @default("FULL_TIME")
  ownerId                String?
  owner                  User?          @relation("JobOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  hiringManagerContactId String?
  hiringManagerContact   ClientContact? @relation(fields: [hiringManagerContactId], references: [id], onDelete: SetNull)
  organizationId         String
  organization           Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  openings               Int            @default(1)
  location               String?
  deadline               DateTime?
  salaryMin              Decimal?       @db.Decimal(12, 2)
  salaryMax              Decimal?       @db.Decimal(12, 2)
  requiredSkills         String[]       @default([])
  experienceMin          Decimal?       @db.Decimal(4, 1)
  experienceMax          Decimal?       @db.Decimal(4, 1)
  status                 JobStatus      @default(DRAFT)
  closingReason          String?
  closingNote            String?
  pauseReason            String?
  resumeReason           String?
  reopenReason           String?
  approvedById           String?
  approvedAt             DateTime?
  isArchived             Boolean        @default(false)
  archivedAt             DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  createdById            String?

  rounds                 JobRound[]
  assignments            JobAssignment[]
  statusHistories        JobStatusHistory[]
  reassignmentRequests   JobReassignmentRequest[]
  applications           Application[]
  threads                Thread[]
  convertedFromOpportunity Opportunity?      @relation("OpportunityConvertedJob")
  approvals              JobApproval[]

  @@index([organizationId])
  @@index([clientId])
  @@index([ownerId])
  @@index([status])
  @@index([isArchived])
}

model JobRound {
  id              String      @id @default(uuid())
  jobId           String
  job             Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name            String
  roundOrder      Int
  interviewType   String      @default("VIDEO")
  durationMinutes Int         @default(45)
  panelMembers    String[]    @default([])
  description     String?
  isArchived      Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  createdById     String?

  interviews Interview[]

  @@index([jobId])
  @@index([roundOrder])
  @@index([isArchived])
}

model JobAssignment {
  id          String   @id @default(uuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  recruiterId String
  recruiter   User     @relation("JobRecruiterAssignment", fields: [recruiterId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy  User     @relation("JobAssigner", fields: [assignedById], references: [id], onDelete: Cascade)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@unique([jobId, recruiterId])
  @@index([jobId])
  @@index([recruiterId])
}

model JobStatusHistory {
  id             String     @id @default(uuid())
  jobId          String
  job            Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  previousStatus JobStatus?
  newStatus      JobStatus
  changedById    String
  reason         String?
  note           String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  createdById    String?

  @@index([jobId])
}

model JobReassignmentRequest {
  id                    String    @id @default(uuid())
  jobId                 String
  job                   Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  requestingRecruiterId String
  requestingRecruiter   User      @relation("ReassignmentRequestor", fields: [requestingRecruiterId], references: [id], onDelete: Cascade)
  targetRecruiterId     String?
  targetRecruiter       User?     @relation("ReassignmentTarget", fields: [targetRecruiterId], references: [id], onDelete: SetNull)
  reason                String
  status                String    @default("PENDING")
  reviewedById          String?
  reviewedBy            User?     @relation("ReassignmentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt            DateTime?
  reviewNotes           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  createdById           String?

  @@index([jobId])
  @@index([requestingRecruiterId])
  @@index([targetRecruiterId])
  @@index([status])
}

model JobApproval {
  id                 String     @id @default(uuid())
  jobId              String
  job                Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviewerId         String
  decision           String     // "APPROVED" | "CHANGES_REQUESTED" | "REJECTED"
  comments           String?
  jobVersion         Int        @default(1)
  isInvalidated      Boolean    @default(false)
  invalidatedAt      DateTime?
  invalidationReason String?
  approvedAt         DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  createdById        String?

  @@index([jobId])
  @@index([reviewerId])
}

// ==========================================
// MODULE E: RECRUITMENT PIPELINE
// ==========================================

model Stage {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String?
  name           String
  stageType      ApplicationStatus
  order          Int
  isArchived     Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdById    String?

  applications   Application[]

  @@index([organizationId])
  @@index([organizationId, isArchived, order])
  @@index([clientId])
}

model Application {
  id                String            @id @default(uuid())
  candidateId       String
  candidate         Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId             String
  job               Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stageId           String?
  stage             Stage?            @relation(fields: [stageId], references: [id], onDelete: SetNull)
  status            ApplicationStatus @default(SOURCED)
  rejectionReasonId String?
  rejectionReason   RejectionReason?  @relation(fields: [rejectionReasonId], references: [id], onDelete: SetNull)
  rejectionFeedback String?
  rejectedAt        DateTime?
  appliedAt         DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdById       String?

  stageHistories  ApplicationStageHistory[]
  interviews      Interview[]
  submissions     Submission[]
  offers          Offer[]
  placement       Placement?

  @@unique([candidateId, jobId])
  @@index([candidateId])
  @@index([jobId])
  @@index([stageId])
  @@index([status])
  @@index([jobId, stageId])
  @@index([jobId, stageId, createdAt])
}

model ApplicationStageHistory {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStage     String?
  toStage       String
  changedById   String
  comments      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  createdById   String?

  @@index([applicationId])
}

model RejectionReason {
  id          String   @id @default(uuid())
  code        String   @unique
  reason      String
  category    String
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  applications Application[]

  @@index([category])
  @@index([isArchived])
}

// ==========================================
// MODULE F: INTERVIEW MANAGEMENT
// ==========================================

model Interview {
  id            String           @id @default(uuid())
  applicationId String
  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  roundId       String?
  round         JobRound?        @relation(fields: [roundId], references: [id], onDelete: SetNull)
  scheduledAt   DateTime
  duration      Int              @default(45)
  timezone      String           @default("Asia/Kolkata")
  mode          String           @default("VIDEO")
  provider      String           @default("GOOGLE_MEET")
  meetingLink   String?
  outcome       InterviewOutcome @default(SCHEDULED)
  rescheduleReason    String?
  outcomeNotes        String?
  completedAt         DateTime?
  noShowAt            DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?
  previousScheduledAt DateTime?
  reminderConfig      Json?
  isArchived          Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  createdById   String?

  panelMembers    InterviewPanelMember[]
  feedbacks       InterviewFeedback[]
  slotInvitations SlotInvitation[]
  histories       InterviewHistory[]

  @@index([applicationId])
  @@index([scheduledAt])
  @@index([outcome])
  @@index([isArchived])
}

model InterviewPanelMember {
  id          String    @id @default(uuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("INTERVIEWER")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?

  @@unique([interviewId, userId])
  @@index([interviewId])
  @@index([userId])
}

model InterviewFeedback {
  id             String    @id @default(uuid())
  interviewId    String
  interview      Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  reviewerId     String
  reviewer       User      @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  rating         Int
  feedback       String
  recommendation String
  strengths      String?
  concerns       String?
  technicalScore Int?
  submittedAt    DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  updatedById    String?

  @@unique([interviewId, reviewerId])
  @@index([interviewId])
  @@index([reviewerId])
}

model InterviewHistory {
  id          String    @id @default(uuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  action      String
  fromTime    DateTime?
  toTime      DateTime?
  reason      String?
  actorId     String?
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([interviewId])
  @@index([action])
}

model SlotInvitation {
  id            String     @id @default(uuid())
  interviewId   String?
  interview     Interview? @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  applicationId String
  invitedUserId String?
  token         String     @unique
  status        String     @default("PENDING")
  expiresAt     DateTime
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  createdById   String?

  slotOptions SlotOption[]

  @@index([applicationId])
  @@index([token])
}

model SlotOption {
  id           String         @id @default(uuid())
  invitationId String
  invitation   SlotInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  startTime    DateTime
  endTime      DateTime
  isSelected   Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  createdById  String?

  @@index([invitationId])
}

// ==========================================
// MODULE G: SUBMISSIONS, OFFERS & PLACEMENTS
// ==========================================

model Submission {
  id                     String                   @id @default(uuid())
  code                   String                   @unique
  applicationId          String
  application            Application              @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  version                Int                      @default(1)
  standardProfileVersion String                   @default("1.0")
  approvalStatus         SubmissionApprovalStatus @default(PENDING_MANAGER_APPROVAL)
  approvedById           String?
  matchScore             Int?
  matchDetails           Json?
  sendState              String                   @default("NOT_SENT")
  sentAt                 DateTime?
  sentById               String?
  clientDecision         String?
  clientFeedback         String?
  isArchived             Boolean                  @default(false)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  createdById            String?

  approvals       SubmissionApproval[]
  profileVersions SubmissionProfileVersion[]

  @@index([applicationId])
  @@index([approvalStatus])
  @@index([isArchived])
}

model SubmissionApproval {
  id                 String     @id @default(uuid())
  submissionId       String
  submission         Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerId         String
  decision           String
  comments              String?
  profileVersion        Int?
  submissionVersion     Int?       @default(1)
  clientWorkflowVersion Int?       @default(1)
  validationSnapshot    Json?
  contentHash           String?
  isInvalidated      Boolean    @default(false)
  invalidatedAt      DateTime?
  invalidationReason String?
  approvedAt         DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  createdById        String?

  @@index([submissionId])
  @@index([reviewerId])
}

model SubmissionProfileVersion {
  id                   String     @id @default(uuid())
  submissionId         String
  submission           Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  versionNumber        Int
  versionTag           String
  headline             String?
  summary              String?
  selectedSkills       String[]   @default([])
  experienceHighlights Json?
  educationHighlights  Json?
  portfolioUrl         String?
  customSections       Json?
  contentSnapshot      Json
  contentHash          String
  changeSummary        String?
  pdfStoragePath       String?
  isCurrent            Boolean    @default(true)
  createdById          String
  createdBy            User       @relation("ProfileVersionAuthor", fields: [createdById], references: [id])
  createdAt            DateTime   @default(now())

  @@unique([submissionId, versionNumber])
  @@index([submissionId])
  @@index([createdById])
}

model Offer {
  id                String      @id @default(uuid())
  applicationId     String
  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  clientId          String
  client            Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  offeredSalary     Decimal     @db.Decimal(12, 2)
  joiningDate       DateTime?
  status            OfferStatus @default(DRAFT)
  offerDocumentUrl  String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  createdById       String?

  @@index([applicationId])
  @@index([clientId])
  @@index([status])
}

model Placement {
  id            String        @id @default(uuid())
  applicationId String        @unique
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  feeBasis      String        @default("PERCENTAGE")
  feeAmount     Decimal       @db.Decimal(12, 2)
  paymentTerms  String        @default("NET_30")
  dueDate       DateTime?
  paymentStatus PaymentStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdById   String?

  @@index([applicationId])
  @@index([clientId])
  @@index([paymentStatus])
}

// ==========================================
// MODULE H: SALES & CLIENT RELATIONSHIP
// ==========================================

model Opportunity {
  id                String             @id @default(uuid())
  title             String             @default("New Business Mandate")
  companyName       String
  clientId          String?
  client            Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  primaryContactId  String?
  primaryContact    ClientContact?     @relation(fields: [primaryContactId], references: [id], onDelete: SetNull)
  contactName       String?
  contactEmail      String?
  contactPhone      String?
  industry          String?
  location          String?
  estimatedOpenings Int?               @default(1)
  estimatedValue    Decimal?           @db.Decimal(12, 2)
  expectedCloseDate DateTime?
  nextFollowUpAt    DateTime?
  stage             OpportunityStage   @default(PROSPECTING)
  priority          String             @default("MEDIUM")
  notes             String?
  ownerId           String
  owner             User               @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isArchived        Boolean            @default(false)
  convertedJobId    String?            @unique
  convertedJob      Job?               @relation("OpportunityConvertedJob", fields: [convertedJobId], references: [id], onDelete: SetNull)
  convertedAt       DateTime?
  convertedById     String?
  convertedBy       User?              @relation("OpportunityConvertedBy", fields: [convertedById], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  createdById       String?

  history           OpportunityHistory[]
  meetings          Meeting[]
  activities        RecruiterActivity[]

  @@index([organizationId])
  @@index([clientId])
  @@index([ownerId])
  @@index([stage])
  @@index([nextFollowUpAt])
  @@index([isArchived])
}

model OpportunityHistory {
  id            String       @id @default(uuid())
  opportunityId String
  opportunity   Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  action        String
  previousStage String?
  newStage      String?
  details       String?
  metadata      Json?
  actorId       String?
  createdAt     DateTime     @default(now())

  @@index([opportunityId])
  @@index([createdAt])
}

model Meeting {
  id               String        @id @default(uuid())
  clientId         String?
  client           Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  opportunityId    String?
  opportunity      Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  organizerId      String
  organizer        User          @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  meetingType      String?       @default("CLIENT_CHECK_IN")
  status           String        @default("SCHEDULED")
  scheduledAt      DateTime
  durationMinutes  Int           @default(30)
  participants     String[]      @default([])
  contactName      String?
  contactEmail     String?
  notes            String?
  outcome          String?
  nextAction       String?
  nextFollowUpAt   DateTime?
  calendarEventId  String?
  calendarProvider String?       @default("DEMO_MODE")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  createdById      String?

  @@index([clientId])
  @@index([opportunityId])
  @@index([organizerId])
  @@index([scheduledAt])
}

// ==========================================
// MODULE I: COMMUNICATIONS & AUTOMATION
// ==========================================

model Template {
  id                    String         @id @default(uuid())
  title                 String
  channel               MessageChannel
  subject               String?
  body                  String
  variables             String[]       @default([])
  category              String         @default("OUTREACH")
  status                String         @default("PUBLISHED")
  providerApprovalState String         @default("DRAFT")
  providerTemplateId    String?
  language              String         @default("en")
  organizationId        String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  createdById           String?

  messages              Message[]

  @@index([channel])
  @@index([category])
  @@index([status])
}

model TeamSignature {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  signatureHtml  String
  isDefault      Boolean  @default(true)
  organizationId String?
  designation    String?
  companyName    String?
  phone          String?
  logoUrl        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?

  @@index([userId])
}

model Thread {
  id                  String         @id @default(uuid())
  channel             MessageChannel
  subject             String?
  candidateId         String?
  candidate           Candidate?     @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  clientId            String?
  jobId               String?
  job                 Job?           @relation(fields: [jobId], references: [id], onDelete: SetNull)
  assignedRecruiterId String?
  assignedRecruiter   User?          @relation("ThreadAssignedRecruiter", fields: [assignedRecruiterId], references: [id], onDelete: SetNull)
  unreadCount         Int            @default(0)
  lastMessageAt       DateTime       @default(now())
  isArchived          Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  createdById         String?

  messages            Message[]

  @@index([candidateId])
  @@index([clientId])
  @@index([jobId])
  @@index([assignedRecruiterId])
  @@index([channel])
  @@index([lastMessageAt])
}

model Message {
  id                String           @id @default(uuid())
  threadId          String
  thread            Thread           @relation(fields: [threadId], references: [id], onDelete: Cascade)
  channel           MessageChannel
  direction         MessageDirection
  status            String           @default("SENT")
  sender            String
  recipient         String
  body              String
  providerMessageId String?
  deliveryStatus    String           @default("SENT")
  templateId        String?
  template          Template?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  attachments       Json?
  errorMessage      String?
  metadata          Json?
  sentAt            DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  createdById       String?

  @@index([threadId])
  @@index([channel])
  @@index([sentAt])
  @@index([providerMessageId])
  @@index([deliveryStatus])
}

model IntegrationAccount {
  id                String    @id @default(uuid())
  userId            String?
  user              User?     @relation("UserIntegrationAccounts", fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  email             String?
  accountIdentifier String?
  encryptedTokens   String
  scopes            String[]  @default([])
  status            String    @default("ACTIVE")
  connectionState   String    @default("SETUP_REQUIRED")
  expiresAt         DateTime?
  lastRefreshedAt   DateTime?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdById       String?

  @@index([userId])
  @@index([provider])
  @@index([connectionState])
}

model CandidateActivity {
  id          String           @id @default(uuid())
  candidateId String
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  type        String
  channel     MessageChannel?
  direction   MessageDirection?
  title       String
  description String?
  metadata    Json?
  actorId     String?
  createdAt   DateTime         @default(now())

  @@index([candidateId])
  @@index([type])
  @@index([createdAt])
}

model AutomationRule {
  id            String   @id @default(uuid())
  name          String
  triggerEvent  String
  conditions    Json
  actions       Json
  version       Int      @default(1)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?

  @@index([triggerEvent])
  @@index([isActive])
}

model Task {
  id                   String       @id @default(uuid())
  title                String
  description          String?
  assignedToId         String
  assignedTo           User         @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)
  dueDate              DateTime?
  status               TaskStatus   @default(PENDING)
  priority             TaskPriority @default(MEDIUM)
  relatedInterviewId   String?
  relatedApplicationId String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  createdById          String?

  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
  @@index([relatedInterviewId])
  @@index([relatedApplicationId])
}

model Notification {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?

  @@index([userId])
  @@index([readAt])
}

model NotificationPreference {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel     String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@unique([userId, channel])
  @@index([userId])
}

// ==========================================
// MODULE J: REPORTING, IMPORTS & AUDIT
// ==========================================

model ReportDefinition {
  id          String   @id @default(uuid())
  name        String
  queryConfig Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  scheduledReports ScheduledReport[]
}

model ScheduledReport {
  id                 String           @id @default(uuid())
  reportDefinitionId String
  reportDefinition   ReportDefinition @relation(fields: [reportDefinitionId], references: [id], onDelete: Cascade)
  cronExpression     String
  recipients         String[]         @default([])
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  createdById        String?

  deliveries ReportDelivery[]

  @@index([reportDefinitionId])
}

model ReportDelivery {
  id                String          @id @default(uuid())
  scheduledReportId String
  scheduledReport   ScheduledReport @relation(fields: [scheduledReportId], references: [id], onDelete: Cascade)
  deliveredAt       DateTime        @default(now())
  status            String          @default("DELIVERED")
  fileUrl           String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdById       String?

  @@index([scheduledReportId])
}

model ImportBatch {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batchCode          String       @unique
  fileName           String
  importType         String       @default("BULK_RESUME") // BULK_RESUME, CSV, JOB_BOARD
  uploadedById       String
  totalRecords       Int          @default(0)
  processedRecords   Int          @default(0)
  parsedRecords      Int          @default(0)
  duplicateRecords   Int          @default(0)
  failedRecords      Int          @default(0)
  pendingReviewCount Int          @default(0)
  status             String       @default("CREATED") // CREATED, UPLOADING, QUEUED, PROCESSING, PARTIALLY_COMPLETED, COMPLETED, FAILED, CANCELLED
  cancelledAt        DateTime?
  completedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  createdById        String?

  items ImportItem[]

  @@index([organizationId])
  @@index([uploadedById])
  @@index([status])
}

model ImportItem {
  id                   String      @id @default(uuid())
  organizationId       String
  importBatchId        String
  importBatch          ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  fileName             String
  fileKey              String?
  fileSize             Int?
  mimeType             String?
  fileChecksum         String?
  recordData           Json?
  parserConfidence     Decimal?    @db.Decimal(5, 2)
  duplicateStatus      String      @default("NO_MATCH") // NO_MATCH, EXACT_DUPLICATE, POSSIBLE_DUPLICATE
  duplicateCandidateId String?
  duplicateScore       Decimal?    @db.Decimal(5, 2)
  duplicateReasons     String[]    @default([])
  status               String      @default("PENDING") // PENDING, PROCESSING, AWAITING_REVIEW, APPROVED, REJECTED, FAILED
  errorMessage         String?
  createdCandidateId   String?
  reviewedById         String?
  reviewedAt           DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  createdById          String?

  @@index([organizationId])
  @@index([importBatchId])
  @@index([status])
  @@index([duplicateStatus])
}

model DuplicatePair {
  id                   String    @id @default(uuid())
  organizationId       String
  primaryCandidateId   String
  duplicateCandidateId String
  matchScore           Decimal   @db.Decimal(5, 2)
  matchReasons         String[]  @default([])
  status               String    @default("UNREVIEWED") // UNREVIEWED, RESOLVED_DIFFERENT, MERGED, IGNORED
  resolvedAt           DateTime?
  resolvedById         String?
  mergeId              String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdById          String?

  @@index([organizationId])
  @@index([primaryCandidateId])
  @@index([duplicateCandidateId])
  @@index([status])
}

model CandidateMerge {
  id                   String   @id @default(uuid())
  organizationId       String
  masterCandidateId    String
  secondaryCandidateId String
  mergedById           String
  mergeReason          String
  fieldsRetained       Json
  preservedCounts      Json
  createdAt            DateTime @default(now())

  @@index([organizationId])
  @@index([masterCandidateId])
  @@index([secondaryCandidateId])
}

model ExtensionCaptureToken {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([tokenHash])
}

model SourcingItem {
  id                   String       @id @default(uuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source               String       // MANUAL_UPLOAD, BULK_IMPORT, CHROME_EXTENSION, INBOUND_EMAIL, NAUKRI, FOUNDIT
  sourceMetadata       Json?
  candidateName        String?
  email                String?
  phone                String?
  currentCompany       String?
  currentTitle         String?
  location             String?
  skills               String[]     @default([])
  experienceYears      Decimal?     @db.Decimal(4, 1)
  resumeStorageKey     String?
  rawText              String?
  assignedRecruiterId  String?
  jobId                String?
  tags                 String[]     @default([])
  notes                String?
  status               String       @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, REJECTED
  duplicateStatus      String       @default("NO_MATCH")
  duplicateCandidateId String?
  duplicateScore       Decimal?     @db.Decimal(5, 2)
  duplicateReasons     String[]     @default([])
  createdCandidateId   String?
  reviewedById         String?
  reviewedAt           DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([organizationId])
  @@index([source])
  @@index([status])
  @@index([assignedRecruiterId])
  @@index([jobId])
}

model SourcingIntegration {
  id                   String       @id @default(uuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider             String       // NAUKRI, FOUNDIT, INBOUND_EMAIL
  status               String       @default("SETUP_REQUIRED") // CONNECTED, DISCONNECTED, SETUP_REQUIRED, ERROR
  encryptedCredentials String?
  config               Json?
  lastSyncAt           DateTime?
  lastError            String?
  connectedById        String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([organizationId, provider])
  @@index([organizationId])
}

model DownloadPolicy {
  id                    String       @id @default(uuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role                  String       // RECRUITER, MANAGER, CLIENT, ADMIN
  dailyCvLimit          Int          @default(50)
  requireWatermark      Boolean      @default(true)
  watermarkPattern      String       @default("HIREFLOW / {{CLIENT_NAME}} / {{DATE}}")
  allowOriginalDownload Boolean      @default(false)
  isActive              Boolean      @default(true)
  updatedById           String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@unique([organizationId, role])
  @@index([organizationId])
}

model DownloadLog {
  id               String   @id @default(uuid())
  userId           String
  resourceType     String   // CV, EXPORT, REPORT, CANDIDATE_DOCUMENT, CLIENT_DOCUMENT
  resourceId       String
  organizationId   String?
  entityType       String?  // CANDIDATE, CLIENT, JOB, EXPORT
  entityId         String?
  documentId       String?
  purpose          String?  // CLIENT_SUBMISSION, RECRUITER_REVIEW, AUDIT, COMPLIANCE
  clientId         String?
  jobId            String?
  fileFormat       String?  // PDF, CSV, XLSX, DOCX
  watermarkApplied Boolean  @default(false)
  watermarkText    String?
  result           String   @default("SUCCESS") // SUCCESS, DENIED, FAILED
  denialReason     String?  // DAILY_LIMIT_EXCEEDED, UNAUTHORIZED_SCOPE, REVERIFICATION_REQUIRED
  requestId        String?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdById      String?

  @@index([userId])
  @@index([organizationId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

model ExportRequest {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType      String       // CANDIDATES, JOBS, CLIENTS, APPLICATIONS, SUBMISSIONS, INTERVIEWS, PLACEMENTS, AUDIT_LOGS
  format          String       @default("CSV") // CSV, XLSX
  selectedColumns String[]
  filters         Json?        // { dateRange: { start, end }, clientId, jobId, status }
  status          String       @default("PENDING") // PENDING, READY, FAILED, EXPIRED
  fileKey         String?      // Randomized storage key in private storage
  fileName        String?
  fileSize        Int?
  rowCount        Int?
  downloadCount   Int          @default(0)
  expiresAt       DateTime     // 24-hour retention
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@index([expiresAt])
}

model DailyActivity {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                DateTime @db.Date
  candidatesSourced   Int      @default(0)
  callsMade           Int      @default(0)
  emailsSent          Int      @default(0)
  submissionsSent     Int      @default(0)
  interviewsScheduled Int      @default(0)
  interviewsCompleted Int      @default(0)
  offersReleased      Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdById         String?

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model RecruiterActivity {
  id                   String        @id @default(uuid())
  actorId              String
  actor                User          @relation("RecruiterLoggedActivities", fields: [actorId], references: [id], onDelete: Cascade)
  organizationId       String
  type                 String        // CALL, MEETING, TASK, NOTE
  relatedCandidateId   String?
  relatedCandidate     Candidate?    @relation(fields: [relatedCandidateId], references: [id], onDelete: SetNull)
  relatedClientId      String?
  relatedClient        Client?       @relation(fields: [relatedClientId], references: [id], onDelete: SetNull)
  relatedOpportunityId String?
  relatedOpportunity   Opportunity?  @relation(fields: [relatedOpportunityId], references: [id], onDelete: SetNull)
  durationMinutes      Int?
  notes                String?
  outcome              String?
  createdAt            DateTime      @default(now())

  @@index([actorId])
  @@index([organizationId])
  @@index([type])
  @@index([createdAt])
}

model RecruiterTarget {
  id                      String       @id @default(uuid())
  userId                  String
  user                    User         @relation("RecruiterTargets", fields: [userId], references: [id], onDelete: Cascade)
  organizationId          String
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  period                  String       @default("DAILY") // DAILY, WEEKLY, MONTHLY
  targetCandidatesSourced Int          @default(10)
  targetCalls             Int          @default(20)
  targetEmails            Int          @default(15)
  targetSubmissions       Int          @default(3)
  targetInterviews        Int          @default(2)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@unique([userId, period])
  @@index([userId])
  @@index([organizationId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}
