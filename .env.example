# Environment Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Database (Supabase PostgreSQL via Prisma ORM)
# DATABASE_URL: Session / Transaction Pooler URL (Port 6543)
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct Database Connection URL (Port 5432) for Prisma Migrations
DIRECT_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Redis (BullMQ / Caching)
REDIS_URL=redis://localhost:6379

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# Storage Provider (local | s3 | memory)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
# S3 / Supabase Storage Configuration (Required if STORAGE_PROVIDER=s3)
# S3_BUCKET_NAME=hireflow-resumes
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://[YOUR_PROJECT_REF].supabase.co/storage/v1/s3

# Resume Parser Provider (mock | claude)
RESUME_PARSER_PROVIDER=mock
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Antivirus Scanner Provider (mock | clamav)
ANTIVIRUS_PROVIDER=mock
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310

# Sentry & Observability Configuration (Prompt 16)
# Leave SENTRY_DSN empty to operate in safe disabled mode (local logging only)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=hireflow-ats@0.1.0

